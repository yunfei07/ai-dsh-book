{
  "name": "ai-dsh-book",
  "description": "A bilingual practical guide to DeepSeek Harness plugin development, powered by FumaPress.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunfei07/ai-dsh-book.git"
  },
  "homepage": "https://github.com/yunfei07/ai-dsh-book",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "waku dev",
    "test": "node --test scripts/*.test.mjs",
    "build": "waku build && node scripts/normalize-static-output.mjs",
    "start": "waku start",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "check": "pnpm test && pnpm types:check && pnpm build && pnpm deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fumapress/language": "^0.1.3",
    "fumadocs-core": "^16.11.1",
    "fumadocs-mdx": "^15.1.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.11.1",
    "fumapress": "0.7.3",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.7",
    "waku": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@takumi-rs/core": "^2.5.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
